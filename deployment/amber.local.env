# Catalogizer distributed deployment config — amber.local
#
# Target host: amber.local
#   - Hardware: CPU host, additional RAM
#   - Role: secondary catalog-api/web instance for distributed deployment
#   - Runtime: rootless Docker (Ubuntu 6.8, no podman)
#
# Usage:
#   scp /tmp/catalogizer-api-latest.tar amber.local:/tmp/
#   ssh amber.local docker load -i /tmp/catalogizer-api-latest.tar
#   ssh amber.local bash < deployment/amber-up.sh

# Docker network (isolated from host default network)
CZ_AMBER_NETWORK=catalogizer-amber

# Port mappings (127.0.0.1 bound — no LAN exposure)
CZ_AMBER_POSTGRES_PORT=5446
CZ_AMBER_REDIS_PORT=6392
CZ_AMBER_API_PORT=8093

# Container names (suffixed with -amber to avoid collision)
CZ_AMBER_POSTGRES_NAME=cz-postgres-amber
CZ_AMBER_REDIS_NAME=cz-redis-amber
CZ_AMBER_API_NAME=cz-api-amber

# Resource limits (CONST-033 30-40% host budget)
CZ_AMBER_POSTGRES_CPUS=1
CZ_AMBER_POSTGRES_MEMORY=2g
CZ_AMBER_REDIS_CPUS=1
CZ_AMBER_REDIS_MEMORY=1g
CZ_AMBER_API_CPUS=2
CZ_AMBER_API_MEMORY=4g

# DB credentials (dev defaults; rotate for production)
POSTGRES_USER=catalogizer
POSTGRES_PASSWORD=catalogizer
POSTGRES_DB=catalogizer
JWT_SECRET=dev-secret-for-operational-run-needs-32-plus-chars-to-be-valid
ADMIN_PASSWORD=admin123
GIN_MODE=release
DB_TYPE=postgres

API_IMAGE=localhost/catalogizer-api:latest
