# Catalogizer distributed deployment config — thinker.local
#
# Target host: thinker.local
#   - Hardware: RTX 3060 6GB GPU, 30 GB RAM, ~14 GB swap
#   - Role: vision backend (Ollama) + secondary catalog-api instance
#   - Runtime: rootless Podman 4.9.3
#
# Usage:
#   scp /tmp/catalogizer-api-latest.tar thinker.local:/tmp/
#   ssh thinker.local podman load -i /tmp/catalogizer-api-latest.tar
#   ssh thinker.local bash < deployment/thinker-up.sh
#
# HelixQA vision routing (set in HelixQA/.env):
#   HELIX_VISION_HOST=thinker.local
#   HELIX_OLLAMA_URL=http://thinker.local:11434
#   HELIX_OLLAMA_MODEL=minicpm-v:8b
#   HELIX_VISION_HOSTS=thinker.local

# Podman network (isolated from host default network)
CZ_THINKER_NETWORK=catalogizer-thinker

# Port mappings (127.0.0.1 bound — no LAN exposure)
CZ_THINKER_POSTGRES_PORT=5445
CZ_THINKER_REDIS_PORT=6391
CZ_THINKER_API_PORT=8092

# Container names
CZ_THINKER_POSTGRES_NAME=cz-postgres-thinker
CZ_THINKER_REDIS_NAME=cz-redis-thinker
CZ_THINKER_API_NAME=cz-api-thinker

# Resource limits (30-40% of thinker.local: 2 CPU, 4 GB)
CZ_THINKER_POSTGRES_CPUS=1
CZ_THINKER_POSTGRES_MEMORY=2g
CZ_THINKER_REDIS_CPUS=1
CZ_THINKER_REDIS_MEMORY=1g
CZ_THINKER_API_CPUS=2
CZ_THINKER_API_MEMORY=4g

# PostgreSQL credentials (dev only — rotate for production)
POSTGRES_USER=catalogizer
POSTGRES_PASSWORD=catalogizer
POSTGRES_DB=catalogizer

# catalog-api config
JWT_SECRET=dev-secret-for-operational-run-needs-32-plus-chars-to-be-valid
ADMIN_PASSWORD=admin123
GIN_MODE=release
DB_TYPE=postgres

# Vision backend (Ollama already running on thinker.local:11434)
OLLAMA_HOST=thinker.local
OLLAMA_PORT=11434
OLLAMA_MODEL=minicpm-v:8b
