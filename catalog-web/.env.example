VITE_API_BASE_URL=http://localhost:8080

# Collections API Configuration
# Set to 'true' to force mock API usage (for testing/development)
VITE_FORCE_MOCK_COLLECTIONS=false

# Set to 'true' to disable mock API and always use real API
VITE_DISABLE_MOCK_COLLECTIONS=false

# API URL for backend (if set, will try real API first in development)
VITE_API_URL=http://localhost:8080