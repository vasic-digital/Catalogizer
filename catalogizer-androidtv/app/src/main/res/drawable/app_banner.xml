<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark gray background (not black) for launcher card visibility.
         Standard Android TV banner size is 320x180dp. -->
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#FF424242" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Centered app icon — sized large for TV visibility (3x original) -->
    <item
        android:gravity="center"
        android:width="140dp"
        android:height="140dp">
        <bitmap
            android:src="@mipmap/ic_launcher"
            android:gravity="center" />
    </item>
</layer-list>
