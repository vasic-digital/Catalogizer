<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allow cleartext HTTP for LAN API discovery and local network communication.
        Production traffic to catalogizer.dev uses HTTPS.
        The Catalogizer API is typically discovered on LAN via IP addresses
        which require cleartext HTTP since they can't have TLS certificates.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
